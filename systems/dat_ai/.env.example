# DAT.AI environment template.
#
# Copy to .env and fill in. .env is git-ignored — NEVER commit real values.
#   cp .env.example .env && chmod 600 .env
#
# Keys only. No secrets in this file, ever.

# =====================================================================
# Runtime posture
# =====================================================================
# development | test | commissioning | production
#
#   development    simulated helpers permitted (never written as observed)
#   test           automated tests; no network, no credentials
#   commissioning  real credentials and real data, writes gated per-product
#   production     real data only; every synthetic path raises
DAT_AI_RUNTIME_MODE=development

LOG_LEVEL=INFO
LOG_FORMAT=json

# =====================================================================
# Database
# =====================================================================
POSTGRES_DB=datai
POSTGRES_USER=datai
POSTGRES_PASSWORD=

# Inside Docker:  postgresql://datai:<password>@db:5432/datai
# From the host:  postgresql://datai:<password>@localhost:5432/datai
# Keep these distinct. Never hard-code localhost into container config.
DATABASE_URL=

# =====================================================================
# Satellite pipeline
# =====================================================================
SATELLITE_ENABLED=false

# Recurring weekly ingestion. Leave false until every commissioning gate in
# docs/COMMISSIONING.md has passed.
SATELLITE_SCHEDULER_ENABLED=false

SATELLITE_MAX_CLOUD_COVER=30
SATELLITE_AOI_CONFIG=configs/aoi/dong_nai.geojson
SATELLITE_AOI_NAME=dong_nai
SATELLITE_CACHE_DIR=data/satellite_cache

# =====================================================================
# Copernicus Data Space — catalogue (no credentials required)
# =====================================================================
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1/search
CDSE_COLLECTION=sentinel-2-l2a

# =====================================================================
# Copernicus Data Space — imagery acquisition (CREDENTIALS REQUIRED)
#
# Discovery works without credentials. Downloading imagery does not.
# Configure EITHER the S3 pair OR the OData pair. S3 is preferred.
# =====================================================================

# Option 1 (preferred): S3-compatible access.
# Generate CDSE-specific keys at:
#   https://eodata-s3keysmanager.dataspace.copernicus.eu/
# These are NOT AWS keys. Do not reuse AWS_ACCESS_KEY_ID here — the variable
# names are deliberately distinct to prevent credential coupling.
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
CDSE_S3_BUCKET=eodata
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=

# Option 2: OData over HTTPS, using your Copernicus Data Space account.
# Register at https://dataspace.copernicus.eu/
CDSE_USERNAME=
CDSE_PASSWORD=

# =====================================================================
# Planet Labs (OPTIONAL validation source)
#
# Leave blank if unavailable. DAT.AI remains fully operational without it;
# affected changes are marked 'unavailable' and routed to manual review.
# No imagery is ever fabricated in its absence.
# =====================================================================
PLANET_API_KEY=

# =====================================================================
# Model
# =====================================================================
MODEL_PATH=backend/models/satellite_classifier_v1.2.pth
MODEL_VERSION=v1.2

# Must remain false until docs/MODEL_CARD.md records real held-out evaluation
# metrics for a genuinely trained checkpoint. Setting this true against an
# untrained checkpoint is detected and overridden by the model audit.
MODEL_PROMOTED_FOR_PRODUCTION=false

# =====================================================================
# API
# =====================================================================
# Required in production mode; ignored in development (which allows "*").
CORS_ALLOW_ORIGINS=

VITE_API_BASE=http://localhost:8000

# =====================================================================
# NOT USED by DAT.AI
#
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / S3_BUCKET are intentionally
# absent. DAT.AI does not persist processed products to AWS S3; imagery lives
# in the local cache under SATELLITE_CACHE_DIR. Reintroduce them only if that
# genuinely changes.
# =====================================================================
