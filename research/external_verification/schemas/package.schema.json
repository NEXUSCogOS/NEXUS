{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXUS-EVA Verification Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "version",
    "layer",
    "claim_ids",
    "system_version",
    "lifecycle_state"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "experiment_id": {
      "type": ["string", "null"]
    },
    "system_version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "package_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "lifecycle_state": {
      "enum": [
        "DRAFT",
        "PACKAGE_FROZEN",
        "DISPATCHED",
        "RECEIVED",
        "INTEGRITY_VERIFIED",
        "INDEPENDENCE_VERIFIED",
        "ADJUDICATED",
        "SEALED"
      ]
    }
  }
}
